<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <!-- Card slot -->
    <FrameLayout
        android:id="@+id/itemRoot"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@drawable/bg_card_slot_front"
        android:padding="6dp">

        <!-- Image -->
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent" />

        <!-- ✅ Unselected dimming overlay: displayed by default, strength controlled by alpha -->
        <View
            android:id="@+id/vOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:alpha="0.42" />

        <!-- ✅ Selected stroke (new) -->
        <View
            android:id="@+id/vBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_selected_border"
            android:alpha="0" />

        <!-- (Keep the old id to avoid breaking historical logic; but it will not be used in the future) -->
        <TextView
            android:id="@+id/tvCheckMark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_select_badge"
            android:visibility="gone" />

        <!-- ✅ Selected indicator: centered -->
        <ImageView
            android:id="@+id/ivCheckGold"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_gold"
            android:alpha="0"
            android:elevation="2dp"
            android:visibility="visible" />

    </FrameLayout>

</FrameLayout>
