<?xml version="1.0" encoding="utf-8"?>
<!-- Main Activity Layout - Dark Gold UI -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    tools:context=".activities.MainActivity">

    <!-- Background texture -->
    <ImageView
        android:id="@+id/ivBgTexture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_main_texture"
        android:scaleType="centerCrop"
        android:alpha="0.28"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top Logo (PNG) -->
    <ImageView
        android:id="@+id/ivMainLogo"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:src="@drawable/logo_memory_game"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>

    <!-- =========================
         User Chip (2/3 width, centered)
         Keep original IDs: layoutUserInfo / tvVipStatus / tvUsername
         ========================= -->
    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="4dp"
        android:background="@drawable/bg_panel_metal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ivMainLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.66"
        android:layout_marginTop="22dp">

        <TextView
            android:id="@+id/tvVipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0F0D10"
            android:background="@drawable/bg_vip_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Username"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textColor="#E9D9A6"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- =========================
         Buttons (NO OUTER PANEL)
         Keep original IDs: layoutButtons / btnStartGame / btnLeaderboard / btnLogout / btnLoginPrompt
         ========================= -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@null"
        android:padding="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutUserInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.78"
        android:layout_marginTop="100dp">

        <!-- Login Button -->
        <Button
            android:id="@+id/btnLoginPrompt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Login"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#E9D9A6"
            android:background="@drawable/bg_button_gold"
            android:backgroundTint="@null"
            android:layout_marginBottom="14dp"
            android:visibility="visible"/>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Start Game"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#E9D9A6"
            android:background="@drawable/bg_button_gold"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Leaderboard"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#E9D9A6"
            android:background="@drawable/bg_button_gold"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Logout"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="#E9D9A6"
            android:background="@drawable/bg_button_gold"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:visibility="gone"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
