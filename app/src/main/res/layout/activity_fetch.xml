<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_dark"
    android:padding="14dp">

    <!-- ===== Top HUD ===== -->
    <LinearLayout
        android:id="@+id/hudFetch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_metal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top row: Back / Title / Confirm -->
        <!-- Top row: Back / Title / Confirm (replace RelativeLayout with ConstraintLayout to resolve text conflicts) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <!-- Back: keep original id -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_hud_icon_button"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E9D9A6"
                android:contentDescription="Back"
                android:padding="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- Confirm: keep original id (slightly adjust padding to make it more like a badge and not crowd the title) -->
            <Button
                android:id="@+id/btnConfirmSelection"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Confirm (0/6)"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:textColor="#E9D9A6"
                android:background="@drawable/bg_button_gold"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Title: key change is here
                 1) Set width to 0dp + left/right constraints to ensure no conflict with side controls
                 2) Single line + ellipsize, show Fetch Ima... if too crowded
            -->
            <TextView
                android:id="@+id/tvFetchTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Fetch Images"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textColor="#E9D9A6"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintEnd_toStartOf="@id/btnConfirmSelection"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Info bar: hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hud_infobar"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvHintFetch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select 6 images to start the game"
                android:textSize="13sp"
                android:textColor="#B9A46A" />

            <TextView
                android:id="@+id/tvSourceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOURCE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#E9D9A6"
                android:alpha="0.70"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

    <!-- URL input area (keep original id etUrl) -->
    <EditText
        android:id="@+id/etUrl"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_dark"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="Enter URL"
        android:text="https://stocksnap.io"
        android:inputType="textUri"
        android:textColor="#E9D9A6"
        android:textColorHint="#7F6F45"
        app:layout_constraintTop_toBottomOf="@id/hudFetch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fetch button (keep original id btnFetch) -->
    <Button
        android:id="@+id/btnFetch"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Fetch Images"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#E9D9A6"
        android:background="@drawable/bg_button_gold"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/etUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress bar (keep original id) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:max="100"
        android:progressTint="#C9AA43"
        android:progressBackgroundTint="#241F26"
        app:layout_constraintTop_toBottomOf="@id/btnFetch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Downloading 0 of 20 images..."
        android:textSize="12sp"
        android:textColor="#B9A46A"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Image grid (keep original id rvImages) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvImages"
        android:layout_width="0dp"
        android.layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvProgress"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Continue button (keep compatibility id, hidden by default) -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Continue to Game"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#E9D9A6"
        android:background="@drawable/bg_button_gold"
        app:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:enabled="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
