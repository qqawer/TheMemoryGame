<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_metal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Top row: Back / Title / Restart -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_hud_icon_button"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:tint="#E9D9A6"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="The Memory Game"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="#E9D9A6" />

        <ImageButton
            android:id="@+id/btnRestart"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_hud_icon_button"
            android:src="@drawable/ic_restart"
            android:contentDescription="Restart"
            android:tint="#E9D9A6"
            android:padding="8dp" />

    </RelativeLayout>

    <!-- Info bar: Matches / Time -->
    <LinearLayout
        android:id="@+id/hudInfoBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hud_infobar"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvMatches"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Matches: 0 / 6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D6C28A" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D6C28A" />
            
    </LinearLayout>

</LinearLayout>
