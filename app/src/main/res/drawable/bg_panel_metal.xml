<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 外描边：暗金 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0F0D10" />
            <stroke android:width="2dp" android:color="#3A2D12" />
        </shape>
    </item>

    <!-- 内层：金属渐变 -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#1B1720"
                android:endColor="#0C0A0E"/>
        </shape>
    </item>

    <!-- 顶部细高光 -->
    <item android:left="6dp" android:top="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <size android:height="2dp" />
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
