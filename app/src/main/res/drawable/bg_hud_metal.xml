<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ① Base color: deep charcoal black -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E0C10"/>
        </shape>
    </item>

    <!-- ② Metal vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1B1720"
                android:centerColor="#0F0D10"
                android:endColor="#211B24"/>
        </shape>
    </item>

    <!-- ③ Thin top highlight (to give it a "face") -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <size android:height="2dp"/>
            <solid android:color="#22FFFFFF"/>
        </shape>
    </item>

    <!-- ④ Bottom dark edge (to give it "thickness") -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <size android:height="3dp"/>
            <solid android:color="#33000000"/>
        </shape>
    </item>

</layer-list>
