<?xml version="1.0" encoding="utf-8"?>
<!--
    VIP badge background
    
    File path:
    app/src/main/res/drawable/bg_vip_badge.xml
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Background color -->
    <solid android:color="@color/vip_gold_dark" />
    
    <!-- Rounded corners -->
    <corners android:radius="12dp" />
    
    <!-- Stroke -->
    <stroke
        android:width="1dp"
        android:color="@color/vip_gold" />
</shape>
