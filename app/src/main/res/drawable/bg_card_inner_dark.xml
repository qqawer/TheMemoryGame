<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 内层底：深炭黑 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#121014" />
        </shape>
    </item>

    <!-- 轻微的“材质高光”（右上角更亮一点） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.75"
                android:centerY="0.25"
                android:startColor="#1F1B22"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- 很淡的斜向光泽（让它看起来不是一块平板） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="45"
                android:startColor="#14D4AF37"
                android:centerColor="#00000000"
                android:endColor="#08000000" />
        </shape>
    </item>

</layer-list>
