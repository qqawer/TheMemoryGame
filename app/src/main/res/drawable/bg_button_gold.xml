<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient
                android:angle="270"
                android:startColor="#E2C46A"
                android:endColor="#8E7429"/>
            <stroke
                android:width="2dp"
                android:color="#E2C46A"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <layer-list>

            <!-- Base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <solid android:color="#0B0A0D"/>
                </shape>
            </item>

            <!-- Subtle inner light -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <gradient
                        android:angle="270"
                        android:startColor="#22FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>

            <!-- ALWAYS visible border (gold) -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="#C9AA43"/>
                </shape>
            </item>

        </layer-list>
    </item>

</selector>
