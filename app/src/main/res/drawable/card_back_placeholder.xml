<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础面板：深炭黑 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#141216" />
        </shape>
    </item>

    <!-- 内凹阴影（让中间“陷下去”） -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="270"
                android:startColor="#08000000"
                android:endColor="#26000000" />
        </shape>
    </item>

    <!-- 暗金材质光泽（非常淡） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:type="radial"
                android:centerX="0.7"
                android:centerY="0.25"
                android:gradientRadius="260dp"
                android:startColor="#18C9AA43"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- 斜向暗纹高光（增加“材质感”） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="45"
                android:startColor="#10FFFFFF"
                android:centerColor="#00000000"
                android:endColor="#08000000" />
        </shape>
    </item>

</layer-list>
